# Smart Study Portal - Environment Variables
# Copy this file to .env and customize for your environment
# NEVER commit .env to version control!

# =============================================================================
# Database (MySQL)
# =============================================================================
MYSQL_DATABASE=smart_study
MYSQL_USER=smart_study
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# =============================================================================
# Backend (Spring Boot)
# =============================================================================
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_study?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=smart_study
SPRING_DATASOURCE_PASSWORD=change-me

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_TOKEN=dev-internal-token-change-me

# JWT & Session
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_TTL_MINUTES=60
COOKIE_SECURE=false
COOKIE_DOMAIN=
WEB_ORIGIN=http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
STORAGE_BACKEND=local
MAX_UPLOAD_MB=20
USER_STORAGE_QUOTA_MB=500

# Email (Spring Mail) - Configure for production
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@localhost
MAIL_FROM_NAME=Smart Study Portal
MAIL_PROTOCOL=smtp
MAIL_STARTTLS_ENABLE=true
MAIL_SSL_ENABLE=false

# Auth Features
REQUIRE_EMAIL_VERIFICATION=false
BCRYPT_STRENGTH=12
PASSWORD_MIN_LENGTH=10

# Admin Bootstrap (only runs once if no admin exists)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# LLM Provider (AI Tutor) - Optional
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_DAILY_LIMIT_PER_USER=50
TUTOR_RETRIEVAL_THRESHOLD=0.35

# Rate Limiting
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_HOUR=10
RATE_LIMIT_TUTOR_PER_DAY=50
RATE_LIMIT_GLOBAL_PER_MINUTE=100

# Observability
SENTRY_DSN=
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SQL=WARN

# =============================================================================
# Frontend (Next.js)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_APP_NAME=Smart Study
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# =============================================================================
# ML Worker (FastAPI)
# =============================================================================
ML_SERVICE_PORT=8000
OCR_ENABLED=false
OCR_LANGS=eng
EMBEDDINGS_ENABLED=false
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EXTRACTION_TIMEOUT_SECONDS=120
MAX_PAGES_PER_FILE=200
MAX_UNCOMPRESSED_SIZE_MB=50
MAX_ZIP_ENTRIES=1000

# =============================================================================
# Object Storage (S3/MinIO) - Required if STORAGE_BACKEND=s3
# =============================================================================
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BUCKET=smart-study-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false